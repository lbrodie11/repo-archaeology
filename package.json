{
  "name": "repo-archaeology",
  "version": "0.1.0",
  "description": "Dig through git history to find ghost wires: files that change together without importing each other.",
  "type": "module",
  "bin": {
    "repo-archaeology": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "PLAN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Laqwan Brodie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbrodie11/repo-archaeology.git"
  },
  "bugs": {
    "url": "https://github.com/lbrodie11/repo-archaeology/issues"
  },
  "homepage": "https://github.com/lbrodie11/repo-archaeology#readme",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "git",
    "co-change",
    "change-coupling",
    "temporal-coupling",
    "code-review",
    "cli",
    "visualization"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "typescript": "^5.4.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}