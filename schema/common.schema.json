{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lbrodie11/repo-archaeology/v0.9.0/schema/common.schema.json",
  "title": "Repo Archaeology Common Definitions (v1)",
  "description": "Shared JSON Schema definitions for Repo Archaeology CLI v1 JSON outputs.",
  "$defs": {
    "SchemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Major version of the Repo Archaeology JSON output contract."
    },
    "ToolInfo": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "repo-archaeology"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Installed repo-archaeology package version (semver)."
        }
      }
    },
    "Relationship": {
      "type": "string",
      "enum": [
        "ghost",
        "unknown",
        "indirect",
        "direct",
        "test"
      ]
    },
    "BridgeSignal": {
      "type": "string",
      "enum": [
        "parallel-implementation",
        "shared-environment",
        "shared-api-route",
        "shared-event",
        "shared-export"
      ]
    },
    "HiddenBridge": {
      "type": "object",
      "required": [
        "signal",
        "value",
        "filesUsing"
      ],
      "properties": {
        "signal": {
          "$ref": "#/$defs/BridgeSignal"
        },
        "value": {
          "type": "string"
        },
        "filesUsing": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CommitOrigin": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "bot"
      ]
    },
    "WeightingMode": {
      "type": "string",
      "enum": [
        "none",
        "recency",
        "origin",
        "recency+origin"
      ]
    },
    "OriginCounts": {
      "type": "object",
      "required": [
        "human",
        "agent",
        "bot"
      ],
      "properties": {
        "human": {
          "type": "integer",
          "minimum": 0
        },
        "agent": {
          "type": "integer",
          "minimum": 0
        },
        "bot": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OriginShare": {
      "type": "object",
      "required": [
        "human",
        "agent",
        "bot"
      ],
      "properties": {
        "human": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "agent": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bot": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "OriginWeights": {
      "type": "object",
      "properties": {
        "human": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "agent": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bot": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "OriginConfig": {
      "type": "object",
      "properties": {
        "agentAuthorPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "botPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "agentTrailerPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "replaceDefaults": {
          "type": "boolean"
        },
        "weights": {
          "$ref": "#/$defs/OriginWeights"
        }
      }
    },
    "OwnersConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "lookbackDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "maxCommits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "CodeownersProvenance": {
      "type": "string",
      "enum": [
        "base",
        "head",
        "worktree"
      ]
    },
    "SuggestionOwner": {
      "type": "object",
      "required": [
        "name",
        "commits",
        "lastDate"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "login": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "commits": {
          "type": "integer",
          "minimum": 1
        },
        "lastDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "SuggestionOwnersSample": {
      "type": "object",
      "required": [
        "qualifyingCommits",
        "lookbackDays",
        "maxCommits",
        "fromDate",
        "toDate",
        "agentAssistedCommits",
        "excludedNonHumanCommits",
        "incompleteCoverage"
      ],
      "properties": {
        "qualifyingCommits": {
          "type": "integer",
          "minimum": 0
        },
        "lookbackDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "maxCommits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "fromDate": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "toDate": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "agentAssistedCommits": {
          "type": "integer",
          "minimum": 0
        },
        "excludedNonHumanCommits": {
          "type": "integer",
          "minimum": 0
        },
        "incompleteCoverage": {
          "type": "boolean"
        },
        "codeownersSource": {
          "$ref": "#/$defs/CodeownersProvenance"
        },
        "codeownersFile": {
          "type": "string"
        }
      }
    },
    "Settings": {
      "type": "object",
      "required": [
        "maxCommits",
        "maxFilesPerCommit",
        "minShared",
        "minConfidence",
        "ignore",
        "useDefaultIgnores"
      ],
      "properties": {
        "maxCommits": {
          "type": "integer",
          "minimum": 1
        },
        "since": {
          "type": "string"
        },
        "maxFilesPerCommit": {
          "type": "integer",
          "minimum": 1
        },
        "minShared": {
          "type": "integer",
          "minimum": 1
        },
        "minConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "halfLifeDays": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "skipCommits": {
          "type": "string"
        },
        "skipReverts": {
          "type": "boolean"
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "useDefaultIgnores": {
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/OriginConfig"
        },
        "owners": {
          "$ref": "#/$defs/OwnersConfig"
        }
      }
    },
    "HeadInfo": {
      "type": "object",
      "required": [
        "ref",
        "sha"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        }
      }
    },
    "VerdictsMeta": {
      "type": "object",
      "required": ["loaded", "active", "expired", "file"],
      "properties": {
        "loaded": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "expired": {
          "type": "integer",
          "minimum": 0
        },
        "file": {
          "type": "string",
          "const": ".repo-archaeology.verdicts.json"
        }
      }
    },
    "RelationshipVerdictView": {
      "type": "object",
      "required": ["kind", "reason"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["expected", "confirmed"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "until": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "ImportResolutionVia": {
      "type": "string",
      "enum": [
        "relative",
        "paths",
        "workspace",
        "exports",
        "imports",
        "go-package",
        "python-module"
      ]
    },
    "ImportUnresolvedReasonCode": {
      "type": "string",
      "enum": [
        "alias-unmatched",
        "unknown-package",
        "target-missing",
        "not-exported",
        "invalid-target",
        "unsupported-config",
        "ambiguous-package"
      ]
    },
    "ImportsCoverageMeta": {
      "type": "object",
      "required": [
        "scope",
        "filesScanned",
        "internalEdges",
        "external",
        "unresolved",
        "dynamicLoads",
        "unsupportedFiles",
        "sourceUnavailable",
        "heuristicEdges",
        "unresolvedByReason"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "repository",
            "analyzed-files"
          ]
        },
        "filesScanned": {
          "type": "integer",
          "minimum": 0
        },
        "internalEdges": {
          "type": "integer",
          "minimum": 0
        },
        "external": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "dynamicLoads": {
          "type": "integer",
          "minimum": 0
        },
        "unsupportedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "sourceUnavailable": {
          "type": "integer",
          "minimum": 0
        },
        "heuristicEdges": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedByReason": {
          "type": "object",
          "properties": {
            "alias-unmatched": {
              "type": "integer",
              "minimum": 0
            },
            "unknown-package": {
              "type": "integer",
              "minimum": 0
            },
            "target-missing": {
              "type": "integer",
              "minimum": 0
            },
            "not-exported": {
              "type": "integer",
              "minimum": 0
            },
            "invalid-target": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported-config": {
              "type": "integer",
              "minimum": 0
            },
            "ambiguous-package": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "Meta": {
      "type": "object",
      "required": [
        "tool",
        "root",
        "commitsRead",
        "commitsAnalyzed",
        "sweepsSkipped",
        "subjectSkipped",
        "renamesFollowed",
        "files",
        "settings",
        "warnings"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "const": "repo-archaeology"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "$ref": "#/$defs/HeadInfo"
        },
        "commitsRead": {
          "type": "integer",
          "minimum": 0
        },
        "commitsAnalyzed": {
          "type": "integer",
          "minimum": 0
        },
        "sweepsSkipped": {
          "type": "integer",
          "minimum": 0
        },
        "subjectSkipped": {
          "type": "integer",
          "minimum": 0
        },
        "revertsSkipped": {
          "type": "integer",
          "minimum": 0
        },
        "renamesFollowed": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "oldestCommit": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "newestCommit": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "origins": {
          "$ref": "#/$defs/OriginCounts"
        },
        "verdicts": {
          "$ref": "#/$defs/VerdictsMeta"
        },
        "imports": {
          "$ref": "#/$defs/ImportsCoverageMeta"
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cache": {
          "$ref": "#/$defs/CacheMeta",
          "description": "History cache usage for this run (RA-04). Optional; omitted by producers that predate RA-04."
        }
      }
    },
    "CacheMeta": {
      "type": "object",
      "description": "Persistent history cache usage. Excluded from equivalence comparisons: cached and --no-cache runs differ only here.",
      "required": [
        "enabled",
        "hits",
        "misses"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "False when --no-cache or cache.enabled=false disabled the cache."
        },
        "hits": {
          "type": "integer",
          "minimum": 0,
          "description": "Needed commits served from the cache."
        },
        "misses": {
          "type": "integer",
          "minimum": 0,
          "description": "Needed commits parsed from git log in this run."
        },
        "dir": {
          "type": "string",
          "minLength": 1,
          "description": "Cache directory relative to the repository root (POSIX separators), or the literal \"$REPO_ARCHAEOLOGY_CACHE_DIR\" when set by that environment variable. Never an absolute path."
        }
      }
    },
    "EvidenceView": {
      "type": "object",
      "required": [
        "hash",
        "date",
        "author",
        "subject"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "author": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/CommitOrigin"
        }
      }
    },
    "WilsonInterval": {
      "type": "object",
      "description": "Two-sided 95% Wilson score interval for directional confidence, computed from unweighted raw commit counts.",
      "required": [
        "low",
        "high"
      ],
      "properties": {
        "low": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "high": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "RelationshipView": {
      "type": "object",
      "required": [
        "from",
        "to",
        "relationship",
        "why",
        "shared",
        "fromChanges",
        "toChanges",
        "confidence",
        "reverseConfidence",
        "score",
        "weighted",
        "lastTogether",
        "crossesDirectories",
        "evidence"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relationship": {
          "$ref": "#/$defs/Relationship"
        },
        "why": {
          "type": "string"
        },
        "hiddenBridge": {
          "$ref": "#/$defs/HiddenBridge"
        },
        "shared": {
          "type": "integer",
          "minimum": 0
        },
        "fromChanges": {
          "type": "integer",
          "minimum": 0
        },
        "toChanges": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reverseConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interval": {
          "$ref": "#/$defs/WilsonInterval"
        },
        "reverseInterval": {
          "$ref": "#/$defs/WilsonInterval"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weighted": {
          "type": "boolean"
        },
        "weighting": {
          "$ref": "#/$defs/WeightingMode"
        },
        "lastTogether": {
          "type": "string"
        },
        "crossesDirectories": {
          "type": "boolean"
        },
        "originShare": {
          "$ref": "#/$defs/OriginShare"
        },
        "verdict": {
          "$ref": "#/$defs/RelationshipVerdictView"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceView"
          }
        }
      }
    },
    "FamilyEvidenceView": {
      "type": "object",
      "required": [
        "hash",
        "date",
        "author",
        "subject",
        "membersTouched",
        "totalMembers",
        "touchesAllMembers",
        "memberPaths"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "author": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/CommitOrigin"
        },
        "membersTouched": {
          "type": "integer",
          "minimum": 2
        },
        "totalMembers": {
          "type": "integer",
          "minimum": 3
        },
        "touchesAllMembers": {
          "type": "boolean"
        },
        "memberPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FindingFamilyMember": {
      "type": "object",
      "required": [
        "path",
        "dir",
        "variant",
        "changes",
        "connections"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "changes": {
          "type": "integer",
          "minimum": 0
        },
        "connections": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "FindingFamilyView": {
      "type": "object",
      "required": [
        "id",
        "label",
        "stem",
        "fileName",
        "parentDir",
        "why",
        "members",
        "commitsTouchingTwoOrMore",
        "commitsTouchingAll",
        "lastTogether",
        "qualifyingPairs",
        "possiblePairs",
        "complete",
        "relationshipKinds",
        "peakScore",
        "maxPairShared",
        "evidence",
        "allMemberEvidence",
        "relationships"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "stem": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "parentDir": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/FindingFamilyMember"
          }
        },
        "commitsTouchingTwoOrMore": {
          "type": "integer",
          "minimum": 0
        },
        "commitsTouchingAll": {
          "type": "integer",
          "minimum": 0
        },
        "lastTogether": {
          "type": "string"
        },
        "qualifyingPairs": {
          "type": "integer",
          "minimum": 2
        },
        "possiblePairs": {
          "type": "integer",
          "minimum": 3
        },
        "complete": {
          "type": "boolean"
        },
        "relationshipKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relationship"
          }
        },
        "peakScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxPairShared": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FamilyEvidenceView"
          }
        },
        "allMemberEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FamilyEvidenceView"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RelationshipView"
          }
        }
      }
    },
    "RelationshipCounts": {
      "type": "object",
      "required": [
        "ghost",
        "unknown",
        "indirect",
        "direct",
        "test"
      ],
      "properties": {
        "ghost": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "indirect": {
          "type": "integer",
          "minimum": 0
        },
        "direct": {
          "type": "integer",
          "minimum": 0
        },
        "test": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ChangeSource": {
      "type": "string",
      "enum": [
        "branch",
        "staged",
        "unstaged",
        "untracked"
      ]
    },
    "ChangedFileView": {
      "type": "object",
      "required": [
        "path",
        "deleted",
        "sources",
        "hasHistory"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "oldPath": {
          "type": "string"
        },
        "deleted": {
          "type": "boolean"
        },
        "added": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeSource"
          }
        },
        "historyPath": {
          "type": "string"
        },
        "hasHistory": {
          "type": "boolean"
        }
      }
    },
    "DiffEvaluation": {
      "type": "object",
      "required": [
        "commitsAnalyzed",
        "effectiveOptions"
      ],
      "properties": {
        "targetBranchRef": {
          "type": "string"
        },
        "headSha": {
          "type": "string"
        },
        "mergeBaseSha": {
          "type": "string"
        },
        "baselineSha": {
          "type": "string"
        },
        "commitsAnalyzed": {
          "type": "integer",
          "minimum": 0
        },
        "effectiveOptions": {
          "type": "object",
          "required": [
            "minShared",
            "minConfidence",
            "maxCommits",
            "maxFilesPerCommit"
          ],
          "properties": {
            "minShared": {
              "type": "integer",
