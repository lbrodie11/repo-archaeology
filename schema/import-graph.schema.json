{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lbrodie11/repo-archaeology/v0.13.0/schema/import-graph.schema.json",
  "title": "Repo Archaeology Import Graph Result (v1)",
  "description": "JSON output contract for `Repository.importGraph()` and `repo-archaeology imports --json`.",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "meta",
    "files",
    "edges",
    "unresolved",
    "languages"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "tool": {
      "$ref": "common.schema.json#/$defs/ToolInfo"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/Meta"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportGraphEdge"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportGraphUnresolved"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "at": {
      "description": "Present when the graph is of another commit's tree than the session's (`importGraph({ at })`, `imports --at <ref>`; RA-20): the ref as given and its commit SHA. `files`, `edges` and `unresolved` describe that tree.",
      "type": "object",
      "required": [
        "ref",
        "sha"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      }
    }
  },
  "$defs": {
    "ImportEdgeKind": {
      "type": "string",
      "enum": [
        "static",
        "dynamic",
        "reexport",
        "require"
      ]
    },
    "ImportGraphEdge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "specifier",
        "kind"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "specifier": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/ImportEdgeKind"
        },
        "via": {
          "$ref": "common.schema.json#/$defs/ImportResolutionVia"
        },
        "heuristic": {
          "type": "boolean"
        },
        "role": {
          "$ref": "common.schema.json#/$defs/ImportTargetRole"
        },
        "name": {
          "description": "With `role: \"name\"`: the imported name (`mod` in `from pkg import mod`).",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ImportGraphUnresolved": {
      "type": "object",
      "required": [
        "from",
        "specifier",
        "reason"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "specifier": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "reasonCode": {
          "$ref": "common.schema.json#/$defs/ImportUnresolvedReasonCode"
        }
      }
    }
  }
}
