{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lbrodie11/repo-archaeology/v0.9.0/schema/file.schema.json",
  "title": "Repo Archaeology File Result (v1)",
  "description": "JSON output contract for `repo-archaeology file <path> --json`.",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "meta",
    "path",
    "changes",
    "churnPercentile",
    "medianChanges",
    "lastChanged",
    "authors",
    "companions"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "tool": {
      "$ref": "common.schema.json#/$defs/ToolInfo"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/Meta"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "integer",
      "minimum": 0
    },
    "churnPercentile": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "medianChanges": {
      "type": "number",
      "minimum": 0
    },
    "lastChanged": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "author",
          "commits",
          "share"
        ],
        "properties": {
          "author": {
            "type": "string"
          },
          "commits": {
            "type": "integer",
            "minimum": 0
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "companions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileCompanionView"
      }
    },
    "verdicts": {
      "type": "object",
      "required": ["silenced"],
      "properties": {
        "silenced": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "FileCompanionView": {
      "type": "object",
      "required": [
        "from",
        "to",
        "relationship",
        "why",
        "shared",
        "fromChanges",
        "toChanges",
        "confidence",
        "reverseConfidence",
        "score",
        "weighted",
        "lastTogether",
        "crossesDirectories",
        "evidence",
        "wouldAlert"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relationship": {
          "$ref": "common.schema.json#/$defs/Relationship"
        },
        "why": {
          "type": "string"
        },
        "hiddenBridge": {
          "$ref": "common.schema.json#/$defs/HiddenBridge"
        },
        "shared": {
          "type": "integer",
          "minimum": 0
        },
        "fromChanges": {
          "type": "integer",
          "minimum": 0
        },
        "toChanges": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reverseConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interval": {
          "$ref": "common.schema.json#/$defs/WilsonInterval"
        },
        "reverseInterval": {
          "$ref": "common.schema.json#/$defs/WilsonInterval"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weighted": {
          "type": "boolean"
        },
        "weighting": {
          "$ref": "common.schema.json#/$defs/WeightingMode"
        },
        "lastTogether": {
          "type": "string"
        },
        "crossesDirectories": {
          "type": "boolean"
        },
        "originShare": {
          "$ref": "common.schema.json#/$defs/OriginShare"
        },
        "verdict": {
          "$ref": "common.schema.json#/$defs/RelationshipVerdictView"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/EvidenceView"
          }
        },
        "wouldAlert": {
          "type": "boolean"
        }
      }
    }
  }
}
