{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbrodie11/repo-archaeology/blob/main/schema/file.schema.json",
  "title": "Repo Archaeology File Result (v1)",
  "description": "JSON output contract for `repo-archaeology file <path> --json`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "meta",
    "path",
    "changes",
    "churnPercentile",
    "medianChanges",
    "lastChanged",
    "authors",
    "companions"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "tool": { "$ref": "common.schema.json#/$defs/ToolInfo" },
    "meta": { "$ref": "common.schema.json#/$defs/Meta" },
    "path": { "type": "string", "minLength": 1 },
    "changes": { "type": "integer", "minimum": 0 },
    "churnPercentile": { "type": "number", "minimum": 0, "maximum": 1 },
    "medianChanges": { "type": "number", "minimum": 0 },
    "lastChanged": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["author", "commits", "share"],
        "properties": {
          "author": { "type": "string" },
          "commits": { "type": "integer", "minimum": 0 },
          "share": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "companions": {
      "type": "array",
      "items": { "$ref": "#/$defs/FileCompanionView" }
    }
  },
  "$defs": {
    "FileCompanionView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relationship",
        "why",
        "shared",
        "fromChanges",
        "toChanges",
        "confidence",
        "reverseConfidence",
        "score",
        "weighted",
        "lastTogether",
        "crossesDirectories",
        "evidence",
        "wouldAlert"
      ],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "relationship": { "$ref": "common.schema.json#/$defs/Relationship" },
        "why": { "type": "string" },
        "hiddenBridge": { "$ref": "common.schema.json#/$defs/HiddenBridge" },
        "shared": { "type": "integer", "minimum": 0 },
        "fromChanges": { "type": "integer", "minimum": 0 },
        "toChanges": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reverseConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "weighted": { "type": "boolean" },
        "lastTogether": { "type": "string" },
        "crossesDirectories": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/EvidenceView" }
        },
        "wouldAlert": { "type": "boolean" }
      }
    }
  }
}
