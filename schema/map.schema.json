{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lbrodie11/repo-archaeology/v0.12.0/schema/map.schema.json",
  "title": "Repo Archaeology Map Result (v1)",
  "description": "JSON output contract for `repo-archaeology map --json`.",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "meta",
    "file",
    "nodes",
    "edges",
    "counts",
    "patchesIncluded"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "tool": {
      "$ref": "common.schema.json#/$defs/ToolInfo"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/Meta"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "integer",
      "minimum": 0
    },
    "edges": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "$ref": "common.schema.json#/$defs/RelationshipCounts"
    },
    "patchesIncluded": {
      "type": "boolean"
    },
    "verdicts": {
      "type": "object",
      "required": ["silenced"],
      "properties": {
        "silenced": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
