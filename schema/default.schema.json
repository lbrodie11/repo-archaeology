{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lbrodie11/repo-archaeology/v0.6.0/schema/default.schema.json",
  "title": "Repo Archaeology Default Command Result (v1)",
  "description": "JSON output contract for bare `repo-archaeology --json` (discriminated by `mode`: `'diff'` or `'scan'`).",
  "oneOf": [
    {
      "title": "Default Command in Diff Mode",
      "type": "object",
      "required": [
        "schemaVersion",
        "tool",
        "mode",
        "meta",
        "evaluation",
        "changed",
        "totalSuggestions",
        "suggestions",
        "families"
      ],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "tool": { "$ref": "common.schema.json#/$defs/ToolInfo" },
        "mode": { "type": "string", "const": "diff" },
        "meta": { "$ref": "common.schema.json#/$defs/Meta" },
        "base": { "type": "string" },
        "evaluation": { "$ref": "common.schema.json#/$defs/DiffEvaluation" },
        "changed": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/ChangedFileView" }
        },
        "totalSuggestions": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of qualifying companion suggestions before `--limit` truncation."
        },
        "suggestions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/DiffSuggestion" }
        },
        "families": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/DiffFamilyView" }
        },
        "verdicts": {
          "type": "object",
          "required": ["silenced"],
          "properties": {
            "silenced": { "type": "integer", "minimum": 0 },
            "addedInBranch": { "type": "integer", "minimum": 0 }
          }
        },
        "silence": { "$ref": "common.schema.json#/$defs/SilenceDiagnostics" }
      }
    },
    {
      "title": "Default Command in Scan Mode",
      "type": "object",
      "required": [
        "schemaVersion",
        "tool",
        "mode",
        "changedWithoutHistory",
        "meta",
        "counts",
        "qualifying",
        "classified",
        "truncated",
        "relationships",
        "families"
      ],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "tool": { "$ref": "common.schema.json#/$defs/ToolInfo" },
        "mode": { "type": "string", "const": "scan" },
        "changedWithoutHistory": { "type": "integer", "minimum": 0 },
        "meta": { "$ref": "common.schema.json#/$defs/Meta" },
        "counts": { "$ref": "common.schema.json#/$defs/RelationshipCounts" },
        "qualifying": { "type": "integer", "minimum": 0 },
        "classified": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "relationships": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/RelationshipView" }
        },
        "families": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/FindingFamilyView" }
        },
        "verdicts": {
          "type": "object",
          "required": ["silenced"],
          "properties": {
            "silenced": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  ]
}
