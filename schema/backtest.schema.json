{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lbrodie11/repo-archaeology/v0.3.0/schema/backtest.schema.json",
  "title": "Repo Archaeology Backtest Result (v1)",
  "description": "JSON output contract for `repo-archaeology backtest --json` (including `--ghosts` and `--follow-ups`).",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "meta",
    "k",
    "train",
    "test",
    "queries",
    "soloQueries",
    "strategies",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "tool": {
      "$ref": "common.schema.json#/$defs/ToolInfo"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/Meta"
    },
    "k": {
      "type": "integer",
      "minimum": 1
    },
    "train": {
      "$ref": "#/$defs/CommitWindow"
    },
    "test": {
      "$ref": "#/$defs/CommitWindow"
    },
    "queries": {
      "type": "integer",
      "minimum": 0
    },
    "before": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "soloQueries": {
      "type": "integer",
      "minimum": 0
    },
    "strategies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StrategyScore"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ghostDiagnostics": {
      "$ref": "#/$defs/GhostDiagnostics"
    },
    "followUpBenchmark": {
      "$ref": "#/$defs/FollowUpBenchmarkResult"
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OriginWeightComparison"
      }
    }
  },
  "$defs": {
    "CommitWindow": {
      "type": "object",
      "required": [
        "commits"
      ],
      "properties": {
        "commits": {
          "type": "integer",
          "minimum": 0
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "StrategyScore": {
      "type": "object",
      "required": [
        "name",
        "description",
        "fired",
        "coverage",
        "precision",
        "hitRate",
        "falseAlarmRate",
        "recall"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fired": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hitRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "falseAlarmRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "GhostDiagnostics": {
      "type": "object",
      "required": [
        "classification",
        "queries",
        "fired",
        "suggestions",
        "correct",
        "coverage",
        "hitRate",
        "precision",
        "falseAlarmRate",
        "caveat"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "const": "current-code"
        },
        "queries": {
          "type": "integer",
          "minimum": 0
        },
        "fired": {
          "type": "integer",
          "minimum": 0
        },
        "suggestions": {
          "type": "integer",
          "minimum": 0
        },
        "correct": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hitRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "falseAlarmRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "caveat": {
          "type": "string"
        }
      }
    },
    "FollowUpSignal": {
      "type": "string",
      "enum": [
        "subject-cue",
        "shared-file",
        "immediate-same-author"
      ]
    },
    "FollowUpStrategyScore": {
      "type": "object",
      "required": [
        "name",
        "description",
        "candidates",
        "triggered",
        "coverage",
        "recommendations",
        "correctMatches",
        "falsePositives",
        "hitCandidates",
        "falseAlarmCandidates",
        "hitRate",
        "precision",
        "falsePositiveRate",
        "falseAlarmRate",
        "recall"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "triggered": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "recommendations": {
          "type": "integer",
          "minimum": 0
        },
        "correctMatches": {
          "type": "integer",
          "minimum": 0
        },
        "falsePositives": {
          "type": "integer",
          "minimum": 0
        },
        "hitCandidates": {
          "type": "integer",
          "minimum": 0
        },
        "falseAlarmCandidates": {
          "type": "integer",
          "minimum": 0
        },
        "hitRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "precision": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "falsePositiveRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "falseAlarmRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "FollowUpSignalSummary": {
      "type": "object",
      "required": [
        "signal",
        "candidates",
        "totalLaterFiles",
        "strategies"
      ],
      "properties": {
        "signal": {
          "$ref": "#/$defs/FollowUpSignal"
        },
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "totalLaterFiles": {
          "type": "integer",
          "minimum": 0
        },
        "strategies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FollowUpStrategyScore"
          }
        }
      }
    },
    "FollowUpCandidateCase": {
      "type": "object",
      "required": [
        "initialCommit",
        "followUpCommit",
        "deltaMinutes",
        "signals",
        "trainingCommitsBefore",
        "recommended",
        "matched",
        "falsePositives"
      ],
      "properties": {
        "initialCommit": {
          "type": "object",
          "required": [
            "hash",
            "date",
            "author",
            "subject",
            "origin",
            "files"
          ],
          "properties": {
            "hash": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "author": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "origin": {
              "$ref": "common.schema.json#/$defs/CommitOrigin"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "followUpCommit": {
          "type": "object",
          "required": [
            "hash",
            "date",
            "author",
            "subject",
            "origin",
            "laterFiles"
          ],
          "properties": {
            "hash": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "author": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "origin": {
              "$ref": "common.schema.json#/$defs/CommitOrigin"
            },
            "laterFiles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "deltaMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/FollowUpSignal"
          }
        },
        "trainingCommitsBefore": {
          "type": "integer",
          "minimum": 0
        },
        "recommended": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "falsePositives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FollowUpBenchmarkResult": {
      "type": "object",
      "required": [
        "k",
        "windowHours",
        "initialTrainCommits",
        "heldOutCommits",
        "modelsBuilt",
        "candidatesEvaluated",
        "candidatesWithoutHistory",
        "totalLaterFiles",
        "strategies",
        "bySignal",
        "cases",
        "casesTruncated",
        "methodology",
        "limitations"
      ],
      "properties": {
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "windowHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "initialTrainCommits": {
          "type": "integer",
          "minimum": 0
        },
        "heldOutCommits": {
          "type": "integer",
          "minimum": 0
        },
        "before": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "modelsBuilt": {
          "type": "integer",
          "minimum": 0
        },
        "candidatesEvaluated": {
          "type": "integer",
          "minimum": 0
        },
        "candidatesWithoutHistory": {
          "type": "integer",
          "minimum": 0
        },
        "totalLaterFiles": {
          "type": "integer",
          "minimum": 0
        },
        "strategies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FollowUpStrategyScore"
          }
        },
        "bySignal": {
          "type": "object",
          "required": [
            "subject-cue",
            "shared-file",
            "immediate-same-author"
          ],
          "properties": {
            "subject-cue": {
              "$ref": "#/$defs/FollowUpSignalSummary"
            },
            "shared-file": {
              "$ref": "#/$defs/FollowUpSignalSummary"
            },
            "immediate-same-author": {
              "$ref": "#/$defs/FollowUpSignalSummary"
            }
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FollowUpCandidateCase"
          }
        },
        "casesTruncated": {
          "type": "integer",
          "minimum": 0
        },
        "methodology": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OriginWeightRunMetrics": {
      "type": "object",
      "required": [
        "fired",
        "coverage",
        "precision",
        "hitRate",
        "falseAlarmRate",
        "recall",
        "lift",
        "strategies"
      ],
      "properties": {
        "fired": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hitRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "falseAlarmRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lift": {
          "type": "number",
          "minimum": 0
        },
        "strategies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StrategyScore"
          }
        }
      }
    },
    "OriginWeightDeltaMetrics": {
      "type": "object",
      "required": [
        "fired",
        "coverage",
        "precision",
        "hitRate",
        "falseAlarmRate",
        "recall",
        "lift"
      ],
      "properties": {
        "fired": {
          "type": "integer"
        },
        "coverage": {
          "type": "number"
        },
        "precision": {
          "type": "number"
        },
        "hitRate": {
          "type": "number"
        },
        "falseAlarmRate": {
          "type": "number"
        },
        "recall": {
          "type": "number"
        },
        "lift": {
          "type": "number"
        }
      }
    },
    "OriginWeightComparison": {
      "type": "object",
      "required": [
        "spec",
        "weights",
        "default",
        "weighted",
        "deltas",
        "delta"
      ],
      "properties": {
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "weights": {
          "type": "object",
          "required": [
            "human",
            "agent",
            "bot"
          ],
          "properties": {
            "human": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "agent": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bot": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "default": {
          "$ref": "#/$defs/OriginWeightRunMetrics"
        },
        "weighted": {
          "$ref": "#/$defs/OriginWeightRunMetrics"
        },
        "deltas": {
          "$ref": "#/$defs/OriginWeightDeltaMetrics"
        },
        "delta": {
          "$ref": "#/$defs/OriginWeightDeltaMetrics"
        }
      }
    }
  }
}
