{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lbrodie11/repo-archaeology/v0.13.0/schema/diff.schema.json",
  "title": "Repo Archaeology Diff Result (v1)",
  "description": "JSON output contract for `repo-archaeology diff --json` and `repo-archaeology diff --json-out <file>`.",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "meta",
    "evaluation",
    "changed",
    "totalSuggestions",
    "suggestions",
    "families"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "tool": { "$ref": "common.schema.json#/$defs/ToolInfo" },
    "meta": { "$ref": "common.schema.json#/$defs/Meta" },
    "base": { "type": "string" },
    "evaluation": { "$ref": "common.schema.json#/$defs/DiffEvaluation" },
    "changed": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/ChangedFileView" }
    },
    "totalSuggestions": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of qualifying companion suggestions before `--limit` truncation."
    },
    "suggestions": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/DiffSuggestion" }
    },
    "families": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/DiffFamilyView" }
    },
    "verdicts": {
      "type": "object",
      "required": ["silenced"],
      "properties": {
        "silenced": { "type": "integer", "minimum": 0 },
        "addedInBranch": { "type": "integer", "minimum": 0 }
      }
    },
    "silence": { "$ref": "common.schema.json#/$defs/SilenceDiagnostics" }
  }
}
