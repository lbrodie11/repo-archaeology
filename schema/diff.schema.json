{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbrodie11/repo-archaeology/blob/main/schema/diff.schema.json",
  "title": "Repo Archaeology Diff Result (v1)",
  "description": "JSON output contract for `repo-archaeology diff --json` and `repo-archaeology diff --json-out <file>`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "meta",
    "evaluation",
    "changed",
    "suggestions",
    "families"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "tool": { "$ref": "common.schema.json#/$defs/ToolInfo" },
    "meta": { "$ref": "common.schema.json#/$defs/Meta" },
    "base": { "type": "string" },
    "evaluation": { "$ref": "common.schema.json#/$defs/DiffEvaluation" },
    "changed": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/ChangedFileView" }
    },
    "suggestions": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/DiffSuggestion" }
    },
    "families": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/DiffFamilyView" }
    },
    "silence": { "$ref": "common.schema.json#/$defs/SilenceDiagnostics" }
  }
}
